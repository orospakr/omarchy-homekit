{
  "schemaVersion": 1,
  "id": "ca.orospakr.homekit",
  "name": "HomeKit",
  "version": "1.0.0",
  "author": "Andrew Clunis",
  "description": "Control Apple HomeKit lights, outlets, and scenes through the HomeClaw CLI running on a Mac over SSH",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "HomeKit",
    "description": "Toggle HomeKit accessories, dim lights, and run scenes from the bar.",
    "category": "Home",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "host": "",
      "cliPath": "/Applications/HomeClaw.app/Contents/MacOS/homeclaw-cli",
      "icon": "󰋜",
      "pollSeconds": 10,
      "scrollSpeed": 4.0,
      "hiddenRooms": []
    },
    "schema": [
      {
        "key": "host",
        "type": "string",
        "label": "SSH host (or ~/.ssh/config alias) running HomeClaw",
        "defaultValue": ""
      },
      {
        "key": "cliPath",
        "type": "string",
        "label": "Absolute path to homeclaw-cli on that host",
        "defaultValue": "/Applications/HomeClaw.app/Contents/MacOS/homeclaw-cli"
      },
      {
        "key": "icon",
        "type": "string",
        "label": "Bar icon glyph",
        "defaultValue": "󰋜"
      },
      {
        "key": "pollSeconds",
        "type": "integer",
        "label": "Refresh interval while the panel is open (seconds)",
        "min": 3,
        "max": 120,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "scrollSpeed",
        "type": "number",
        "label": "Trackpad scroll speed factor",
        "defaultValue": 4.0
      },
      {
        "key": "hiddenRooms",
        "type": "array",
        "label": "Rooms to hide from the panel"
      }
    ]
  }
}
